{
  "app": "npx tsx bin/hms.ts",
  "watch": {
    "include": ["bin/**/*", "lib/**/*"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules"
    ]
  },
  "context": {
    "aws-cdk:enableDiffNoFail": "true",
    "@aws-cdk/core:stackRelativeExports": "true",
    "region": "ap-south-1"
  }
}
