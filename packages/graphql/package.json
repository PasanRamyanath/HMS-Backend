{
  "name": "@hms/graphql",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-resolvers.mjs",
    "build:resolvers": "node build-resolvers.mjs",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@aws-appsync/utils": "^2.1.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "graphql": "^16.10.0",
    "typescript": "^5.7.3"
  }
}
