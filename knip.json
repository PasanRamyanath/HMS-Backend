{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "biome": true,
  "lefthook": true,
  "ignoreDependencies": [
    "@biomejs/biome",
    "lefthook",
    "tsx",
    "@aws-appsync/utils",
    "@graphql-codegen/cli",
    "@graphql-codegen/typescript",
    "@graphql-codegen/typescript-operations",
    "graphql",
    "esbuild"
  ],
  "ignoreBinaries": ["biome", "knip", "tsc", "cdk"],
  "workspaces": {
    "packages/core": {
      "project": ["src/**/*.ts!"]
    },
    "packages/graphql": {
      "project": ["src/**/*.ts!"]
    },
    "packages/cdk": {
      "project": ["bin/**/*.ts!", "lib/**/*.ts!"]
    }
  }
}
