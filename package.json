{
  "name": "hms-backend-root",
  "version": "1.0.0",
  "private": true,
  "description": "Sri Lankan Hotel Management System & Contactless QR Platform — Backend Monorepo",
  "workspaces": ["packages/core", "packages/graphql", "packages/cdk"],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "synth": "npm run synth --workspace=@hms/cdk"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.6.5",
    "knip": "^5.43.0",
    "lefthook": "^1.10.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
